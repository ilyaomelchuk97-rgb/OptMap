# OptMap — конфигурация (скопируйте в .env и поправьте под себя)

# Порт и адрес HTTP-сервера
PORT=8787
HOST=0.0.0.0

# Файл дорожного графа (создаётся командой `npm run ingest -- --pbf <файл>`)
GRAPH_PATH=data/graph.json.gz

# Свой профиль загрузки дорог/пробок (см. config/traffic-profile.example.json)
# TRAFFIC_PROFILE=config/my-profile.json

# ---- Геокодер OpenStreetMap (Nominatim, без ключей) ----
# Адресный поиск: публичный сервер OSM или свой инстанс; пусто — выключить
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# ---- Яндекс Карты (опционально; ключи из https://developer.tech.yandex.ru/) ----
# Геокодер: поиск адресов и улиц (определение дорог) через Яндекс
# YANDEX_GEOCODER_KEY=ваш-ключ
# Маршрутизация: честные км/мин с реальными пробками Яндекса
# YANDEX_ROUTER_KEY=ваш-ключ
# JS API: подложка Яндекс Карты в примере /yandex.html (открытый ключ)
# YANDEX_JS_KEY=ваш-ключ-js-api
# Подложка Яндекса в демо через тайл-прокси (off — выключить)
# YANDEX_TILES=on
# Движок по умолчанию: local (OSM-граф) | auto | yandex
# ROUTING_ENGINE=local

# Если граф не найден — сгенерировать демо-город (для боевого режима поставьте false)
ALLOW_SYNTHETIC=true

# Ограничения
MAX_POINTS=50
SNAP_RADIUS_M=400

# URL тайлов карты (по умолчанию OpenStreetMap; можно свой сервер/провайдер)
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
